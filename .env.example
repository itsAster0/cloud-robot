# Local AWS emulator
AWS_ENDPOINT_URL=http://floci:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_SCRIPTS_BUCKET=robot-arena-artifacts
DYNAMODB_MATCHES_TABLE=robot-arena-matches
SQS_MATCH_JOBS_QUEUE=robot-arena-match-jobs

# WorkOS AuthKit. Client ID is public. Never commit WORKOS_API_KEY.
WORKOS_CLIENT_ID=client_01M1EN6565YSSYPRPKA8A5R5MX
VITE_WORKOS_CLIENT_ID=client_01M1EN6565YSSYPRPKA8A5R5MX
# Optional: only needed for future server-side WorkOS API calls. Put the real
# value in .env (gitignored), never here.
WORKOS_API_KEY=
WORKOS_ISSUER=
AUTH_REQUIRED=true

# Dynamic SSH box provisioner. Keep provisioner private and change token outside local review.
PROVISIONER_TOKEN=local-review-token-change-me
ROBOT_BOX_IMAGE=cloud-robot-box:local
SSH_PUBLIC_HOST=localhost
SSH_PORT_START=22000
SSH_PORT_END=22999

# Box resource limits (Docker) and workspace quota (bytes, monitored by supervisor).
BOX_CPUS=1
BOX_MEMORY_MB=512
BOX_PIDS=128
BOX_STORAGE_BYTES=1073741824
