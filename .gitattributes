# Files used inside Linux containers must keep LF endings, even when the
# repository is cloned on Windows with core.autocrlf=true.
* text=auto eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.pptx binary
*.docx binary
*.woff binary
*.woff2 binary
*.mp4 binary
